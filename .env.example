# Copia este archivo a .env y ajusta los valores.
PORT=3000
DATABASE_PATH=snap.db
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Secreto para anonimizar (HMAC) las IPs de los clicks. Opcional: si falta se usa JWT_SECRET,
# pero conviene uno propio, porque cambiarlo rompe la cuenta de visitantes únicos.
CLICK_HASH_SECRET=
